{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend for the ecommerce application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:watch": "jest --watchAll --runInBand",
    "seed": "node utils/seedDatabase.js",
    "reset:db": "node utils/dbCleaner.js",
    "audit:security": "npm audit --audit-level=high && npx snyk test",
    "audit:resolve": "npm-audit-resolver"
  },
  "keywords": [
    "ecommerce",
    "backend",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "csurf": "^1.11.0",
    "morgan": "^1.10.0",
    "stripe": "^18.3.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "jest": "^30.0.4",
    "mongodb-memory-server": "^10.1.4",
    "npm-audit-resolver": "^3.0.0-RC.0",
    "snyk": "^1.1297.3",
    "supertest": "^7.1.3"
  }
}
