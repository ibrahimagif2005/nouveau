# .env.example - Fichier d'exemple pour les variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs réelles nécessaires pour votre environnement.

# Configuration du serveur Backend
NODE_ENV=development
PORT=5000 # Port sur lequel le serveur backend écoutera
# BACKEND_PORT=5000 # Alternative si PORT est utilisé par un autre service (ex: client React)

# URL du client frontend (pour la configuration CORS)
CLIENT_URL=http://localhost:3000 # Ajustez si votre client React tourne sur un port différent

# Configuration MongoDB
MONGO_URI=mongodb://localhost:27017/ecommerce_app_dev # URI de connexion à votre base de données MongoDB

# Configuration JWT (JSON Web Token)
JWT_SECRET=VOTRE_SUPER_SECRET_JWT_A_CHANGER_EN_PRODUCTION # Remplacez par une chaîne aléatoire longue et complexe
JWT_EXPIRES_IN=1h # Durée de validité du token (ex: 1h, 7d, 30d)

# Configuration Email (Nodemailer) - Exemple avec Mailtrap ou un compte de test Gmail
# Pour la production, utilisez un service transactionnel robuste (SendGrid, Mailgun, AWS SES).
EMAIL_HOST=smtp.mailtrap.io # ou smtp.gmail.com
EMAIL_PORT=2525 # ou 587 pour Gmail TLS, 465 pour Gmail SSL
EMAIL_USER=votre_utilisateur_smtp # Utilisateur de votre service SMTP (ex: utilisateur Mailtrap ou email Gmail)
EMAIL_PASS=votre_mot_de_passe_smtp # Mot de passe de votre service SMTP (ex: mot de passe Mailtrap ou mot de passe d'application Gmail)
EMAIL_FROM_NAME="Votre Nom d'Application Ecommerce" # Nom affiché comme expéditeur
EMAIL_FROM_ADDRESS="noreply@votre-domaine.com" # Adresse email affichée comme expéditeur

# Configuration Stripe (Clés de test pour le développement)
# STRIPE_PUBLISHABLE_KEY=pk_test_VOTRE_CLE_PUBLIABLE_STRIPE # Clé publiable pour le frontend
STRIPE_SECRET_KEY=sk_test_VOTRE_CLE_SECRETE_STRIPE_POUR_LE_BACKEND # Clé secrète pour les opérations backend
STRIPE_WEBHOOK_SECRET=whsec_VOTRE_SECRET_DE_WEBHOOK_STRIPE # Secret pour vérifier les webhooks Stripe (obtenu depuis le dashboard Stripe)

# Autres configurations d'API tierces si nécessaire
# API_KEY_AUTRE_SERVICE=xxxxxxxxxxxxxxxxx
# ...

# Note: Ne committez jamais votre fichier .env réel contenant des secrets dans un dépôt public.
# Le fichier .env doit être listé dans .gitignore.
# Ce fichier .env.example sert de modèle pour les autres développeurs.
